# Page ID và Page token của từng Fanpage nằm riêng trong pages.json (tab Fanpage), không cần điền ở đây.
# Bạn không cần tạo tay: mở tab "Cài đặt" trong giao diện, điền rồi bấm Lưu, app sẽ tự ghi file .env.
# KHÔNG đưa file .env lên GitHub và không dán nội dung nó vào chat.

OUTPUT_DIR="~/Documents/My_Project/MakingVideo/OfflineYtb"
DOWNLOAD_MAX_HEIGHT="1080"
DOWNLOAD_SLEEP_MIN="3"
DOWNLOAD_SLEEP_MAX="8"
# Nếu YouTube đòi đăng nhập/xác minh, điền tên trình duyệt (chrome, safari, firefox...)
YTDLP_COOKIES_BROWSER=""

SCHEDULE_TZ="Asia/Tokyo"
SCHEDULE_INTERVAL_HOURS="6"

FB_APP_ID=""
FB_APP_SECRET=""
FB_USER_TOKEN=""
FB_API_VERSION="v21.0"
# Giới hạn lượt gọi Facebook mỗi 60 phút cho cả app (Facebook cho khoảng 200/giờ rồi khóa app; 150 là mức an toàn)
FB_CALLS_PER_HOUR="150"
# Khoảng nghỉ tối thiểu giữa hai lệnh gọi Facebook (giây)
FB_MIN_INTERVAL_SECONDS="0.6"

# Số hashtag tối đa trong caption tự dựng từ mô tả/tiêu đề (caption sửa tay giữ nguyên). 0 = không giới hạn
MAX_HASHTAGS="5"

# Kiểm tra video đạt yêu cầu Reels trước khi hẹn giờ (cần ffprobe): 1 = bật, 0 = tắt
REELS_CHECK="1"

# Thông báo sự cố. Kho video báo đỏ khi còn ít hơn số ngày này.
LOW_STOCK_DAYS="3"
NOTIFY_MAC="1"
# Telegram: tạo bot bằng @BotFather, dán token vào giao diện (Cài đặt chung > Thông báo) thay vì sửa tay ở đây.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Tự kiểm tra và cập nhật yt-dlp mỗi ngày (1 = bật, 0 = tắt)
YTDLP_AUTO_UPDATE="1"

# Chỉnh sửa video (phiên âm + xuất 9:16). Để trống = app tự tìm; chỉ đặt khi công cụ nằm chỗ khác.
# FFMPEG_PATH="/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg"
# WHISPER_CLI="/Users/ban/tools/whisper.cpp/build/bin/whisper-cli"
# WHISPER_MODEL="large-v3-turbo"
# EDIT_FONT="Arial"

# Dịch phụ đề bằng AI (tuỳ chọn; có thể nhập trong Cài đặt chung > Dịch phụ đề)
# TRANSLATE_PROVIDER=anthropic        # hoặc openai (mọi dịch vụ theo chuẩn OpenAI: OpenAI, Gemini, OpenRouter, Groq, Ollama...)
# TRANSLATE_API_KEY=
# TRANSLATE_MODEL=claude-haiku-5-5
# TRANSLATE_BASE_URL=                 # để trống = địa chỉ chính thức của hãng; ví dụ Gemini: https://generativelanguage.googleapis.com/v1beta/openai
